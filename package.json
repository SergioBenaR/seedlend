{
  "name": "seedlend",
  "version": "0.1.0",
  "private": true,
  "description": "Directed investment microcredit prototype for BUIDL CTC 2026 Fall",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:worker": "pnpm --filter @seedlend/worker test",
    "typecheck": "pnpm --filter @seedlend/worker typecheck",
    "preflight": "node scripts/preflight.mjs",
    "verify:networks": "pnpm --filter @seedlend/worker verify:networks",
    "check": "pnpm test && pnpm test:worker && pnpm typecheck"
  },
  "devDependencies": {
    "@gluwa/usc-contracts": "0.1.2"
  }
}
