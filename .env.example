# Use a dedicated testnet key with no real funds.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# Official pre-deployed decoder library used by the current Creditcoin example.
EVM_V1_DECODER_LIBRARY_ADDRESS=0x04B9ae8562D8Cc5bbbBbBB759080dDC30B56D18B

# Fixed supply of the unbacked Sepolia demonstration token (18 decimals).
DEMO_ASSET_INITIAL_SUPPLY=1000000000000000000000000

